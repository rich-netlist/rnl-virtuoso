/* eda-style 0.2.
   Universal IC schematic visual style package for RNL 0.4.
   Applies green hairline symbol strokes (`linewidth=0, linecolor="#00cc66"`),
   red symbol texts (`textcolor="#ff0000"`), solid red 0.8x0.8 terminal squares on the pins of
   instances, grounds and supplies via `@SELECT-PIN`, solid red port polygons, hairline wires
   (`linewidth=0`), and a monospaced font (`Lucida Console, Monaco, DejaVu Sans Mono, Consolas, monospace`).
   Its rules write `recursive=true`, so they reach every level below the one that uses the package.
   Can be used standalone or paired with `eda-symbol` 0.2. */
@RNL(type="header") {
  @VERSION("0.4");
  @PACKAGE(name="eda-style", version="0.2");
  @USE-PACKAGE(name="rnl-std-basic", version="0.4")
}

/* ---------------------------------------------------------------- Default EDA styles and pin square rules */
@RNL {
  /* Default EDA styles:
     - $base: hairline wires and scene annotations (linewidth=0, dark #1d1d1f)
     - $symbol: hairline green symbol strokes (linewidth=0, linecolor="#00cc66") and red symbol texts (textcolor="#ff0000")
     - $port: solid red port polygons (linecolor="#ff0000", fillcolor="#ff0000") and red port texts (textcolor="#ff0000") */
  $base = @DEFINE-STYLE(linecolor="#1d1d1f", textcolor="#1d1d1f", fillcolor="#ffffff", linewidth=0, cap="butt", join="miter", size=1, font="Lucida Console, Monaco, DejaVu Sans Mono, Consolas, monospace") {};
  $symbol = @DEFINE-STYLE(linecolor="#00cc66", textcolor="#ff0000", fillcolor="#ffffff", linewidth=0, cap="butt", join="miter", size=1, font="Lucida Console, Monaco, DejaVu Sans Mono, Consolas, monospace") {};
  $port = @DEFINE-STYLE(linecolor="#ff0000", textcolor="#ff0000", fillcolor="#ff0000", linewidth=0, cap="butt", join="miter", size=1, font="Lucida Console, Monaco, DejaVu Sans Mono, Consolas, monospace") {};
  $bus = @DEFINE-STYLE(linestyle="bold") {};
  $signal = @DEFINE-STYLE(linecolor="#1f4fd8", linestyle="bold") {$base};
  $note = @DEFINE-STYLE(textcolor="#555555", size=0.9) {};
  $grey = @DEFINE-STYLE(linecolor="#9a9a9a", textcolor="#9a9a9a") {};

  # @SELECT-INSTANCE(recursive=true) => @SET-STYLE $symbol;
  # @SELECT-USAGE(recursive=true) => @SET-STYLE $symbol;
  # @SELECT-LABEL(recursive=true) => @SET-STYLE $symbol;
  # @SELECT-NET(recursive=true) => @SELECT-LABEL => @SET-STYLE $base;
  # @SELECT-WIRE(recursive=true) => @SELECT-LABEL => @SET-STYLE $base;
  # @SELECT-USAGE(recursive=true) $JUNCTION => @SET-STYLE $base;
  # @SELECT-USAGE(recursive=true) $CURRENT_ARROW => @SET-STYLE $base;
  # @SELECT-USAGE(recursive=true) $IO_PORT => @SET-STYLE $port;
  # @SELECT-INSTANCE(model="ipin*", recursive=true) => @SET-STYLE $port;
  # @SELECT-INSTANCE(model="opin*", recursive=true) => @SET-STYLE $port;
  # @SELECT-INSTANCE(model="io_port*", recursive=true) => @SET-STYLE $port;
  # @SELECT-WIRE(recursive=true) => @SET-STYLE $base;
  # @SELECT-ANNOTATION(recursive=true) => @SET-STYLE $base;
  # @SELECT-WIRE(bus=true, recursive=true) => @SET-STYLE $bus;
  # @SELECT-WIRE(recursive=true) => @LAYER("bottom");

  /* Automatic red terminal square on the pins of instances (user-defined symbols too) and of grounds and
     supplies. Port models draw a solid red polygon instead. A file adds pins to $PIN_SQUARE_SET or
     removes them from it before the square rule takes effect. */
  $PIN_SQUARE = @DEFINE(roles=[["t", "pin"]]) {
    ?t @RECTANGLE(width=0.8, height=0.8, fill="fillcolor", fillcolor="#ff0000", linestyle="none") => @LAYER("top")
  };
  $PIN_SQUARE_SET = # @SELECT-INSTANCE(recursive=true) => @SELECT-PIN;
  # @SELECT-USAGE(recursive=true) $GROUND => @SELECT-PIN => @ADD-TO $PIN_SQUARE_SET;
  # @SELECT-USAGE(recursive=true) $SUPPLY => @SELECT-PIN => @ADD-TO $PIN_SQUARE_SET;
  # @SELECT-INSTANCE(model="ipin*", recursive=true) => @SELECT-PIN => @REMOVE-FROM $PIN_SQUARE_SET;
  # @SELECT-INSTANCE(model="opin*", recursive=true) => @SELECT-PIN => @REMOVE-FROM $PIN_SQUARE_SET;
  # @SELECT-INSTANCE(model="io_port*", recursive=true) => @SELECT-PIN => @REMOVE-FROM $PIN_SQUARE_SET;
  $PIN_SQUARE @ATTACH $PIN_SQUARE_SET
}
