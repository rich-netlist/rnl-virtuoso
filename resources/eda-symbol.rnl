  # @SELECT-USAGE $ARROW => @SET-SYMBOL $ARROW_SYMBOL;
  # @SELECT-USAGE $SPDT_SWITCH => @SET-SYMBOL $SPDT_SWITCH_SYMBOL;
  $NAMED_GROUND_NET_SET @SELECT-ANCESTOR-USAGE $GROUND => @SET-SYMBOL $NAMED_GROUND_SYMBOL;

  /* SPICE element letter rules */
  # @SELECT-INSTANCE(name="R*") => @SET-SYMBOL $RESISTOR;
  # @SELECT-INSTANCE(name="C*") => @SET-SYMBOL $CAPACITOR;
  # @SELECT-INSTANCE(name="L*") => @SET-SYMBOL $INDUCTOR;
