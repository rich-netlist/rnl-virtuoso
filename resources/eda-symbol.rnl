  # @SELECT-INSTANCE(model="sp1tswitch") => @SET-SYMBOL $SWITCH;
  # @SELECT-INSTANCE(model="sp2tswitch") => @SET-SYMBOL $SPDT_SWITCH_SYMBOL;
  # @SELECT-INSTANCE(model="sp3tswitch") => @SET-SYMBOL $SP3TSWITCH;
  # @SELECT-INSTANCE(model="sp4tswitch") => @SET-SYMBOL $SP4TSWITCH;
  # @SELECT-INSTANCE(model="port") => @SET-SYMBOL $RF_PORT;
  # @SELECT-INSTANCE(model="iprobe") => @SET-SYMBOL $IPROBE;
  # @SELECT-INSTANCE(model="tline") => @SET-SYMBOL $TRANSMISSION_LINE;
  # @SELECT-INSTANCE(model="rcwireload") => @SET-SYMBOL $RC_LINE;
  # @SELECT-INSTANCE(model="delayline") => @SET-SYMBOL $DELAY_CELL_SYMBOL;
  # @SELECT-INSTANCE(model="mixer") => @SET-SYMBOL $MIXER;
  # @SELECT-INSTANCE(model="osc") => @SET-SYMBOL $OSC;
  # @SELECT-INSTANCE(model="quadrature") => @SET-SYMBOL $QUADRATURE;
  # @SELECT-INSTANCE(model="butterworth_lp") => @SET-SYMBOL $LOWPASS_FILTER;
  # @SELECT-INSTANCE(model="butterworth_hp") => @SET-SYMBOL $HIGHPASS_FILTER;
  # @SELECT-INSTANCE(model="butterworth_bp") => @SET-SYMBOL $BANDPASS_FILTER;
  # @SELECT-INSTANCE(model="butterworth_bs") => @SET-SYMBOL $BANDSTOP_FILTER;
  # @SELECT-INSTANCE(model="gnd") => @SET-SYMBOL $GROUND_SYMBOL;
  # @SELECT-INSTANCE(model="gnda") => @SET-SYMBOL $GROUND_SYMBOL;
  # @SELECT-INSTANCE(model="gndd") => @SET-SYMBOL $GROUND_SYMBOL;
  # @SELECT-INSTANCE(model="vdd") => @SET-SYMBOL $SUPPLY_SYMBOL;
  # @SELECT-INSTANCE(model="vdda") => @SET-SYMBOL $SUPPLY_SYMBOL;
  # @SELECT-INSTANCE(model="vddd") => @SET-SYMBOL $SUPPLY_SYMBOL;
  # @SELECT-INSTANCE(model="vcc") => @SET-SYMBOL $SUPPLY_SYMBOL;
  # @SELECT-INSTANCE(model="vcca") => @SET-SYMBOL $SUPPLY_SYMBOL;
  # @SELECT-INSTANCE(model="vccd") => @SET-SYMBOL $SUPPLY_SYMBOL;
  # @SELECT-INSTANCE(model="vss") => @SET-SYMBOL $VSS_SYMBOL;
  # @SELECT-INSTANCE(model="vssa") => @SET-SYMBOL $VSS_SYMBOL;
  # @SELECT-INSTANCE(model="vssd") => @SET-SYMBOL $VSS_SYMBOL;
  # @SELECT-INSTANCE(model="vee") => @SET-SYMBOL $VSS_SYMBOL;
  # @SELECT-INSTANCE(model="veea") => @SET-SYMBOL $VSS_SYMBOL;
  # @SELECT-INSTANCE(model="veed") => @SET-SYMBOL $VSS_SYMBOL;

  /* Model card type rules (SPICE and Spectre) */
  # @SELECT-INSTANCE(type="d") => @SET-SYMBOL $DIODE;
  # @SELECT-INSTANCE(type="r") => @SET-SYMBOL $RESISTOR;
  # @SELECT-INSTANCE(type="c") => @SET-SYMBOL $CAPACITOR;
