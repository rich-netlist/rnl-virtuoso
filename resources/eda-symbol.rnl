    %a = (-10, 2) @PIN(terminal="a", direction="left");
    %b = (-10, 1) @PIN(terminal="b", direction="left");
    %c = (-10, -1) @PIN(terminal="c", direction="left");
    %d = (-10, -2) @PIN(terminal="d", direction="left");
    %y = (10, 0) @PIN(terminal="y", direction="right");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 3.6)
  };

  /* a b y (vp) (vn); 2-input XNOR gate */
  $XNOR_2INPUT = @DEFINE-SYMBOL(box=[-10, -4, 10, 4]) {
    @LINE {(-3.4, -2) (-10, -2)};
    @LINE {(-3.4, 2) (-10, 2)};
    @LINE {(0.4, -3) (-2.8, -3)};
    @LINE {(0.4, 3) (-2.8, 3)};
    (6, 0) @CIRCLE(radius=0.5);
    @LINE {(6.5, 0) (10, 0)};
    @ARC {(-2.8, -3) (-2, 0) (-2.8, 3)};
    @ARC {(-3.8, -3) (-3, 0) (-3.8, 3)};
    @ARC {(0.4, -3) (3.4, -2.2) (5.5, 0)};
    @ARC {(5.5, 0) (3.4, 2.2) (0.4, 3)};
    %a = (-10, 2) @PIN(terminal="a", direction="left");
    %b = (-10, -2) @PIN(terminal="b", direction="left");
    %y = (10, 0) @PIN(terminal="y", direction="right");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 3.6)
  };

  /* a b c y (vp) (vn); 3-input XNOR gate */
  $XNOR_3INPUT = @DEFINE-SYMBOL(box=[-10, -4, 10, 4]) {
    @LINE {(-3.4, -2) (-10, -2)};
    @LINE {(-3.4, 2) (-10, 2)};
    @LINE {(0.4, -3) (-2.8, -3)};
    @LINE {(0.4, 3) (-2.8, 3)};
    (6, 0) @CIRCLE(radius=0.5);
    @LINE {(6.5, 0) (10, 0)};
    @ARC {(-2.8, -3) (-2, 0) (-2.8, 3)};
    @ARC {(-3.8, -3) (-3, 0) (-3.8, 3)};
    @ARC {(0.4, -3) (3.4, -2.2) (5.5, 0)};
    @ARC {(5.5, 0) (3.4, 2.2) (0.4, 3)};
    @LINE {(-10, 0) (-3, 0)};
    %a = (-10, 2) @PIN(terminal="a", direction="left");
    %b = (-10, 0) @PIN(terminal="b", direction="left");
    %c = (-10, -2) @PIN(terminal="c", direction="left");
    %y = (10, 0) @PIN(terminal="y", direction="right");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 3.6)
  };

  /* a b c d y (vp) (vn); 4-input XNOR gate */
  $XNOR_4INPUT = @DEFINE-SYMBOL(box=[-10, -4, 10, 4]) {
    @LINE {(-3.4, -2) (-10, -2)};
    @LINE {(-3.4, 2) (-10, 2)};
    @LINE {(0.4, -3) (-2.8, -3)};
    @LINE {(0.4, 3) (-2.8, 3)};
    (6, 0) @CIRCLE(radius=0.5);
    @LINE {(6.5, 0) (10, 0)};
    @ARC {(-2.8, -3) (-2, 0) (-2.8, 3)};
    @ARC {(-3.8, -3) (-3, 0) (-3.8, 3)};
    @ARC {(0.4, -3) (3.4, -2.2) (5.5, 0)};
    @ARC {(5.5, 0) (3.4, 2.2) (0.4, 3)};
    @LINE {(-10, 1) (-3.2, 1)};
    @LINE {(-10, -1) (-3.2, -1)};
    %a = (-10, 2) @PIN(terminal="a", direction="left");
    %b = (-10, 1) @PIN(terminal="b", direction="left");
    %c = (-10, -1) @PIN(terminal="c", direction="left");
    %d = (-10, -2) @PIN(terminal="d", direction="left");
    %y = (10, 0) @PIN(terminal="y", direction="right");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 3.6)
  };

  /* a y (vp) (vn); buffer */
  $BUFFER = @DEFINE-SYMBOL(box=[-10, -3, 10, 3]) {
    @LINE {(-4, 3) (3.5, 0) (-4, -3) (-4, 3)};
    @LINE {(-10, 0) (-4, 0)};
    @LINE {(3.5, 0) (10, 0)};
    %a = (-10, 0) @PIN(terminal="a", direction="left");
    %y = (10, 0) @PIN(terminal="y", direction="right");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 3.6)
  };

  /* a y (vp) (vn); inverter */
  $INVERTER = @DEFINE-SYMBOL(box=[-10, -3, 10, 3]) {
    @LINE {(-4, 3) (3.5, 0) (-4, -3) (-4, 3)};
    (4, 0) @CIRCLE(radius=0.5);
    @LINE {(-10, 0) (-4, 0)};
    @LINE {(4.5, 0) (10, 0)};
    %a = (-10, 0) @PIN(terminal="a", direction="left");
    %y = (10, 0) @PIN(terminal="y", direction="right");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 3.6)
  };

  /* d ck q qb (vp) (vn); D flip-flop */
  $D_FLIP_FLOP = @DEFINE-SYMBOL(box=[-8, -5, 8, 5]) {
    @RECTANGLE {(-4, -5) (4, 5)};
    @LINE {(-4, -3) (-8, -3)};
    @LINE {(5, -3) (8, -3)};
    @LINE {(4, 3) (8, 3)};
    @LINE {(-4, 3) (-8, 3)};
    (4.5, -3) @CIRCLE(radius=0.5);
    %d = (-8, 3) @PIN(terminal="d", direction="left");
    %ck = (-8, -3) @PIN(terminal="ck", direction="left");
    %q = (8, 3) @PIN(terminal="q", direction="right");
    %qb = (8, -3) @PIN(terminal="qb", direction="right");
    (2.4, 2.6) @TEXT("Q", halign="middle", valign="baseline", size=1);
    (-3, 2.6) @TEXT("D", halign="middle", valign="baseline", size=1);
    (2.6, -3.6) @TEXT("Q-", halign="middle", valign="baseline", size=1);
    (-2.2, -3.4) @TEXT("CLK", halign="middle", valign="baseline", size=1);
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(-3, 6);
    ? @TEXT("${value}", key="value", halign="middle") => @PLACE(0, 1.2)
  };

  /* d ck q (vp) (vn); D flip-flop (Q output only) */
  $D_FLIP_FLOP_Q_ONLY = @DEFINE-SYMBOL(box=[-8, -5, 8, 5]) {
    @RECTANGLE {(-4, -5) (4, 5)};
    @LINE {(-4, 3) (-8, 3)};
    @LINE {(-4, -3) (-8, -3)};
    @LINE {(4, 0) (8, 0)};
    %d = (-8, 3) @PIN(terminal="d", direction="left");
    %ck = (-8, -3) @PIN(terminal="ck", direction="left");
    %q = (8, 0) @PIN(terminal="q", direction="right");
    (2.4, -0.4) @TEXT("Q", halign="middle", valign="baseline", size=1);
    (-3, 2.6) @TEXT("D", halign="middle", valign="baseline", size=1);
    (-2.2, -3.4) @TEXT("CLK", halign="middle", valign="baseline", size=1);
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(-3, 6);
    ? @TEXT("${value}", key="value", halign="middle") => @PLACE(0, 1.2)
  };

  /* d ck rst q qb (vp) (vn); D flip-flop with reset */
  $D_FLIP_FLOP_WITH_RESET = @DEFINE-SYMBOL(box=[-8, -6, 8, 5]) {
    @RECTANGLE {(-4, -5) (4, 5)};
    @LINE {(-4, -3) (-8, -3)};
    @LINE {(5, -3) (8, -3)};
    @LINE {(4, 3) (8, 3)};
    @LINE {(-4, 3) (-8, 3)};
    (4.5, -3) @CIRCLE(radius=0.5);
    @LINE {(0, -5) (0, -6)};
    %d = (-8, 3) @PIN(terminal="d", direction="left");
    %ck = (-8, -3) @PIN(terminal="ck", direction="left");
    %rst = (0, -6) @PIN(terminal="rst", direction="down");
    %q = (8, 3) @PIN(terminal="q", direction="right");
    %qb = (8, -3) @PIN(terminal="qb", direction="right");
    (2.4, 2.6) @TEXT("Q", halign="middle", valign="baseline", size=1);
    (-3, 2.6) @TEXT("D", halign="middle", valign="baseline", size=1);
    (2.6, -3.6) @TEXT("Q-", halign="middle", valign="baseline", size=1);
    (-2.2, -3.4) @TEXT("CLK", halign="middle", valign="baseline", size=1);
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(-3, 6);
    ? @TEXT("${value}", key="value", halign="middle") => @PLACE(0, 1.2);
    (0, -4.6) @TEXT("R", halign="middle", valign="baseline", size=0.9)
  };

  /* a y; delay cell */
  $DELAY_CELL = @DEFINE-SYMBOL(box=[-11, -2, 11, 2]) {
    @LINE {(-11, 0) (-7, 0)};
    @LINE {(11, 0) (7, 0)};
    @RECTANGLE {(-7, -2) (7, 2)};
    %a = (-11, 0) @PIN(terminal="a", direction="left");
    %y = (11, 0) @PIN(terminal="y", direction="right");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(9, 2);
    (0, 0) @TEXT("delay", halign="middle", valign="middle", size=1)
  };

  /* draws $ADDER; in1 in2 out */
  $ADDER_SYMBOL = @DEFINE-SYMBOL(box=[-4, -4, 4, 2]) {
    @LINE {(0, 1) (0, -1)};
    @LINE {(-1, 0) (1, 0)};
    (0, 0) @CIRCLE(radius=2);
    @LINE {(-4, 0) (-2, 0)};
    @LINE {(0, -4) (0, -2)};
    @LINE {(2, 0) (4, 0)};
    %a = (-4, 0) @PIN(terminal="in1", direction="left");
    %b = (0, -4) @PIN(terminal="in2", direction="down");
    %y = (4, 0) @PIN(terminal="out", direction="right");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 2.6);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(2.2, -2.5)
  };

  /* draws $MULTIPLIER; in1 in2 out */
  $MULTIPLIER_SYMBOL = @DEFINE-SYMBOL(box=[-4, -4, 4, 2]) {
    @LINE {(-1, -1) (1, 1)};
    @LINE {(-1, 1) (1, -1)};
    (0, 0) @CIRCLE(radius=2);
    @LINE {(-4, 0) (-2, 0)};
    @LINE {(0, -4) (0, -2)};
    @LINE {(2, 0) (4, 0)};
    %a = (-4, 0) @PIN(terminal="in1", direction="left");
    %b = (0, -4) @PIN(terminal="in2", direction="down");
    %y = (4, 0) @PIN(terminal="out", direction="right");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 2.6);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(2.2, -2.5)
  };

  /* draws $INTEGRATOR; in out */
  $INTEGRATOR_SYMBOL = @DEFINE-SYMBOL(box=[-8, -4, 8, 4]) {
    @RECTANGLE {(-4, -4) (4, 4)};
    @LINE {(-8, 0) (-4, 0)};
    @LINE {(4, 0) (8, 0)};
    @LINE {(-0.2, -1.4) (0.2, 1.4)};
    @ARC {(-1.0, -1.4) (-0.6, -1.9) (-0.2, -1.4)};
    @ARC {(1.0, 1.4) (0.6, 1.9) (0.2, 1.4)};
    %a = (-8, 0) @PIN(terminal="in", direction="left");
    %y = (8, 0) @PIN(terminal="out", direction="right");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 4.6)
  };

  /* draws $DISCRETE_TIME_INTEGRATOR; in out */
  $DISCRETE_TIME_INTEGRATOR_SYMBOL = @DEFINE-SYMBOL(box=[-8, -4, 8, 4]) {
    @RECTANGLE {(-4, -4) (4, 4)};
    @LINE {(-8, 0) (-4, 0)};
    @LINE {(4, 0) (8, 0)};
    %a = (-8, 0) @PIN(terminal="in", direction="left");
    %y = (8, 0) @PIN(terminal="out", direction="right");
    ? @TEXT("\frac{\textit{z}^{-1}}{1-\textit{z}^{-1}}", key="label", halign="middle", valign="middle", size=1.1) => @PLACE(0, 0);
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 4.6)
  };

  /* draws $QUANTIZER; in out */
  $QUANTIZER_SYMBOL = @DEFINE-SYMBOL(box=[-8, -4, 8, 4]) {
    @RECTANGLE {(-4, -4) (4, 4)};
    @LINE {(8, 0) (4, 0)};
    @LINE {(-8, 0) (-4, 0)};
    %a = (-8, 0) @PIN(terminal="in", direction="left");
    %y = (8, 0) @PIN(terminal="out", direction="right");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(4, 4);
    ? @TEXT("${value}", key="value", halign="middle") => @PLACE(0, 1.2)
  };

  /* draws $UNIT_DELAY; in out */
  $UNIT_DELAY_SYMBOL = @DEFINE-SYMBOL(box=[-6, -3, 6, 3]) {
    @RECTANGLE {(-3, -3) (3, 3)};
    @LINE {(-6, 0) (-3, 0)};
    @LINE {(3, 0) (6, 0)};
    %a = (-6, 0) @PIN(terminal="in", direction="left");
    %y = (6, 0) @PIN(terminal="out", direction="right");
    ? @TEXT("\textit{z}^{-1}", key="label", halign="middle", valign="middle", size=1.2) => @PLACE(0, 0);
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 3.6)
  };
}

/* ---------------------------------------------------------------- Universal schematic symbols (45 symbols) */
@RNL {
  /* 4-terminal voltage-controlled resistor */
  $VCRES = @DEFINE-SYMBOL(box=[-2.5, -4, 1, 4]) {
    @LINE {(0.5, 1.5) (0, 1.5)};
    @LINE {(1, -2) (-1, -2)};
    @LINE {(0.5, 1.5) (0.5, 1)};
    @LINE {(-1, -4) (-1, -3)};
    @LINE {(1, 2) (-1, 2)};
    @LINE {(-1, 2.5) (-1, 4)};
    @LINE {(-1, -3) (-1, -1.8) (-2, -1.5) (0, -0.9) (-2, -0.3) (0, 0.3) (-2, 0.9) (0, 1.5) (-1, 1.8) (-1, 3)};
    @LINE {(-2.5, -1.5) (0.5, 1.5)};
    (-1, 4) @PIN(terminal=1, direction="up");
    (-1, -4) @PIN(terminal=2, direction="down");
    (1, 2) @PIN(terminal=3, direction="right");
    (1, -2) @PIN(terminal=4, direction="right");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(0.5, 3);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(-0.5, 1)
  };

  /* 4-terminal voltage-controlled capacitor */
  $VCCAP = @DEFINE-SYMBOL(box=[-2.5, -4, 1, 4]) {
    @LINE {(-1, 2) (-1, 2.5)};
    @LINE {(-1, -2) (-1, -3)};
    @LINE {(-1, 0) (-1, -2)};
    @LINE {(-1, 1) (0, 1)};
    @LINE {(0.5, 1.5) (0, 1.5)};
    @LINE {(1, -2) (-1, -2)};
    @LINE {(0.5, 1.5) (0.5, 1)};
    @LINE {(-1, -4) (-1, -3)};
    @LINE {(1, 2) (-1, 2)};
    @LINE {(-1, 2.5) (-1, 4)};
    @LINE {(-1, 2) (-1, 1) (-2, 1)};
    @LINE {(-2.5, -1.5) (0.5, 1.5)};
    @ARC {(0, -0.6) (-1, -0.1) (-2, -0.6)};
    (-1, 4) @PIN(terminal=1, direction="up");
    (-1, -4) @PIN(terminal=2, direction="down");
    (1, 2) @PIN(terminal=3, direction="right");
    (1, -2) @PIN(terminal=4, direction="right");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(0.5, 3);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(-0.5, 1)
  };

  /* 4-terminal ideal balun transformer */
  $IDEAL_BALUN = @DEFINE-SYMBOL(box=[-3, -3, 3, 3]) {
    @LINE {(1.2, 3) (3, 3)};
    @LINE {(1.2, 0.7) (2.1, 0.7) (2.1, -2.1) (-3, -2.1) (-3, -3)};
    @LINE {(-1.2, 3) (-3, 3)};
    @LINE {(-1.2, 0.6) (-1.7, 0.6) (-2.1, 1) (-2.1, 3)};
    @LINE {(1.2, 0.8) (1.2, 0.6)};
    @LINE {(-0.2, 2.8) (-0.2, 1)};
    @LINE {(1.2, -1.6) (3, -1.6) (3, -3)};
    @LINE {(-2.1, -1.6) (-0.8, -3) (-0.4, -3)};
    @LINE {(-1.2, 0.8) (-1.7, 0.8) (-2.1, 0.5) (-2.1, -1.6) (-1.2, -1.6)};
    @LINE {(0.2, 2.8) (0.2, 1)};
    @LINE {(-0.2, 0.4) (-0.2, -1.4)};
    @LINE {(0.2, 0.4) (0.2, -1.4)};
    @ARC {(1.2, 3) (0.6, 2.4) (1.2, 1.8)};
    @ARC {(1.2, 2) (0.6, 1.4) (1.2, 0.8)};
    @ARC {(1.2, 0.6) (0.6, 0) (1.2, -0.6)};
    @ARC {(1.2, -0.4) (0.6, -1) (1.2, -1.6)};
    @ARC {(1.2, -0.6) (1.6, -0.5) (1.2, -0.4)};
    @ARC {(-1.2, -1.6) (-0.6, -1) (-1.2, -0.4)};
    @ARC {(1.2, 1.8) (1.6, 1.9) (1.2, 2)};
    @ARC {(-1.2, -0.6) (-0.6, 0) (-1.2, 0.6)};
    @ARC {(-1.2, 0.8) (-0.6, 1.4) (-1.2, 2)};
    @ARC {(-1.2, 1.8) (-0.6, 2.4) (-1.2, 3)};
    @ARC {(-1.2, 2) (-1.6, 1.9) (-1.2, 1.8)};
    @ARC {(-1.2, -0.4) (-1.6, -0.5) (-1.2, -0.6)};
    (3, 3) @PIN(terminal=1, direction="right");
    (3, -3) @PIN(terminal=2, direction="down");
    (-3, 3) @PIN(terminal=3, direction="left");
    (-3, -3) @PIN(terminal=4, direction="down");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(4, 1)
  };

  /* AC / sinusoidal voltage source */
  $VSIN = @DEFINE-SYMBOL(box=[-2, -3, 2, 3]) {
    @LINE {(0, 0.2) (0, 0.8)};
    (0, 0) @CIRCLE(radius=1);
    @LINE {(0.3, -0.5) (-0.3, -0.5)};
    @LINE {(0, 1) (0, 3)};
    @LINE {(0, -1) (0, -3)};
    @LINE {(0.3, 0.5) (-0.3, 0.5)};
    @ARC {(-2.3, 0.1) (-1.9, -0.3) (-1.5, 0.1)};
    @ARC {(-2.3, 0.1) (-2.7, 0.5) (-3.1, 0.1)};
    %p = (0, 3) @PIN(terminal="p", direction="up");
    %n = (0, -3) @PIN(terminal="n", direction="down");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(1, 2);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(1.5, 0.5)
  };

  /* AC / sinusoidal current source */
  $ISIN = @DEFINE-SYMBOL(box=[-2, -3, 2, 3]) {
    @LINE {(0, -0.8) (0, 0.8)};
    (0, 0) @CIRCLE(radius=1);
    @LINE {(0, -1) (0, -3)};
    @LINE {(0, 1) (0, 3)};
    @LINE {(0, -0.8) (0.4, -0.3) (-0.4, -0.3) (0, -0.8)};
    @ARC {(-2.3, 0.1) (-1.9, -0.3) (-1.5, 0.1)};
    @ARC {(-2.3, 0.1) (-2.7, 0.5) (-3.1, 0.1)};
    %p = (0, 3) @PIN(terminal="p", direction="up");
    %n = (0, -3) @PIN(terminal="n", direction="down");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(1, 2);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(1.5, 0.5)
  };

  /* pulse / digital bit-stream voltage source */
  $VPULSE = @DEFINE-SYMBOL(box=[-2, -3, 2, 3]) {
    @LINE {(0, 0.2) (0, 0.8)};
    (0, 0) @CIRCLE(radius=1);
    @LINE {(0.3, -0.5) (-0.3, -0.5)};
    @LINE {(0, 1) (0, 3)};
    @LINE {(0, -1) (0, -3)};
    @LINE {(-3.1, -0.3) (-2.8, -0.3) (-2.8, 0.3) (-2.4, 0.3) (-2.4, -0.3) (-2, -0.3) (-2, 0.3) (-1.6, 0.3) (-1.6, -0.3) (-1.3, -0.3)};
    @LINE {(0.3, 0.5) (-0.3, 0.5)};
    %p = (0, 3) @PIN(terminal="p", direction="up");
    %n = (0, -3) @PIN(terminal="n", direction="down");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(1, 2);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(1.5, 0.5)
  };

  /* pulse / digital bit-stream current source */
  $IPULSE = @DEFINE-SYMBOL(box=[-2, -3, 2, 3]) {
    (0, 0) @CIRCLE(radius=1);
    @LINE {(0, -1) (0, -3)};
    @LINE {(0, 1) (0, 3)};
    @LINE {(-3.1, -0.3) (-2.8, -0.3) (-2.8, 0.3) (-2.4, 0.3) (-2.4, -0.3) (-2, -0.3) (-2, 0.3) (-1.6, 0.3) (-1.6, -0.3) (-1.3, -0.3)};
    @LINE {(0, -0.8) (0.4, -0.3) (-0.4, -0.3) (0, -0.8)};
    @LINE {(0, -0.8) (0, 0.8)};
    %p = (0, 3) @PIN(terminal="p", direction="up");
    %n = (0, -3) @PIN(terminal="n", direction="down");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(1, 2);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(1.5, 0.5)
  };

  /* piecewise-linear / step voltage source */
  $VPWL = @DEFINE-SYMBOL(box=[-2, -3, 2, 3]) {
    @LINE {(0, 0.2) (0, 0.8)};
    (0, 0) @CIRCLE(radius=1);
    @LINE {(0.3, -0.5) (-0.3, -0.5)};
    @LINE {(0, 1) (0, 3)};
    @LINE {(0, -1) (0, -3)};
    @LINE {(0.3, 0.5) (-0.3, 0.5)};
    @LINE {(-3.1, -0.3) (-2.6, 0.3) (-2.2, -0.3) (-1.8, 0.3) (-1.3, -0.3)};
    %p = (0, 3) @PIN(terminal="p", direction="up");
    %n = (0, -3) @PIN(terminal="n", direction="down");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(1, 2);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(1.5, 0.5)
  };

  /* piecewise-linear / step current source */
  $IPWL = @DEFINE-SYMBOL(box=[-2, -3, 2, 3]) {
    @LINE {(0, -0.8) (0, 0.8)};
    (0, 0) @CIRCLE(radius=1);
    @LINE {(0, -1) (0, -3)};
    @LINE {(0, 1) (0, 3)};
    @LINE {(0, -0.8) (0.4, -0.3) (-0.4, -0.3) (0, -0.8)};
    @LINE {(-3.1, -0.3) (-2.6, 0.3) (-2.2, -0.3) (-1.8, 0.3) (-1.3, -0.3)};
    %p = (0, 3) @PIN(terminal="p", direction="up");
    %n = (0, -3) @PIN(terminal="n", direction="down");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(1, 2);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(1.5, 0.5)
  };

  /* differential-output 4-terminal VCVS */
  $VCVSP = @DEFINE-SYMBOL(box=[-3, -4, 3, 4]) {
