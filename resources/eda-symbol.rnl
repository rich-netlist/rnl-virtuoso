/* eda-symbol 0.1.
   Streamlined, universal IC schematic symbol library for RNL 0.3.
   Defines all 93 standard RNL 0.3 symbol names (`$RESISTOR`, `$CAPACITOR`, `$NMOS_4TERM`, `$OPAMP`,
   `$AND_2INPUT`, etc.), 44 visually distinct universal IC schematic symbols (`$VSIN`, `$VPULSE`,
   `$VPWL`, `$IDEAL_BALUN`, `$MIXER`, `$LOWPASS_FILTER`, `$VC_VG_DIFFAMP`, etc.), and instance/usage
   symbol selection rules with pure, style-agnostic geometry. Pair with `eda-style` 0.1 for Virtuoso-like
   green hairline strokes, red symbol texts, solid red terminal squares, and hairline wires. */
@RNL(type="header") { @VERSION("0.3"); @PACKAGE(name="eda-symbol", version="0.1")}

/* ---------------------------------------------------------------- Standard RNL 0.3 symbols (93 symbols) */
@RNL {
  /* p n; resistor */
  $RESISTOR = @DEFINE-SYMBOL(box=[-2, -3, 2, 3]) {
    @LINE {(0, -3) (0, -1.8) (-1, -1.5) (1, -0.9) (-1, -0.3) (1, 0.3) (-1, 0.9) (1, 1.5) (0, 1.8) (0, 3)};
    (0, 3) @PIN(terminal=1, direction="up");
    (0, -3) @PIN(terminal=2, direction="down");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(1.5, 2);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(1.5, 0.5)
  };

  /* p n; variable resistor */
  $VARIABLE_RESISTOR = @DEFINE-SYMBOL(box=[-2, -3, 2, 3]) {
    @LINE {(0, -3) (0, -1.8) (-1, -1.5) (1, -0.9) (-1, -0.3) (1, 0.3) (-1, 0.9) (1, 1.5) (0, 1.8) (0, 3)};
    @LINE {(-1.5, -1.5) (1.2, 1.2)};
    @LINE(fill="linecolor", linestyle="none") {(1.5, 1.5) (0.8, 1.25) (1.25, 0.8) (1.5, 1.5)};
    (0, 3) @PIN(terminal=1, direction="up");
    (0, -3) @PIN(terminal=2, direction="down");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(1.5, 2);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(1.5, 0.5)
  };

  /* p n; capacitor */
  $CAPACITOR = @DEFINE-SYMBOL(box=[-2, -3, 2, 3]) {
    @LINE {(1, 0.8) (-1, 0.8)};
    @LINE {(0, 3) (0, 0.8)};
    @LINE {(0, 0.2) (0, -3)};
    @ARC {(1, -0.2) (0, 0.2) (-1, -0.2)};
    (0, 3) @PIN(terminal=1, direction="up");
    (0, -3) @PIN(terminal=2, direction="down");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(1, 2);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(1.5, 0.5)
  };

  /* p n; variable capacitor */
  $VARIABLE_CAPACITOR = @DEFINE-SYMBOL(box=[-2, -3, 2, 3]) {
    @LINE {(1, 0.8) (-1, 0.8)};
    @LINE {(0, 3) (0, 0.8)};
    @LINE {(0, 0.2) (0, -3)};
    @ARC {(1, -0.2) (0, 0.2) (-1, -0.2)};
    @LINE {(-1.5, -1.5) (1.2, 1.2)};
    @LINE(fill="linecolor", linestyle="none") {(1.5, 1.5) (0.8, 1.25) (1.25, 0.8) (1.5, 1.5)};
    (0, 3) @PIN(terminal=1, direction="up");
    (0, -3) @PIN(terminal=2, direction="down");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(1, 2);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(1.5, 0.5)
  };

  /* p n; inductor */
  $INDUCTOR = @DEFINE-SYMBOL(box=[-2, -3, 2, 3]) {
    @LINE {(0, 1.6) (0.2, 1.6)};
    @LINE {(0, -1.6) (0, -3)};
    @LINE {(0, 0.8) (0.2, 0.8)};
    (0.8, 2.2) @CIRCLE(radius=0.3);
    @LINE {(0, 0) (0.2, 0)};
    @LINE {(0, -1.6) (0.2, -1.6)};
    @LINE {(0, -0.8) (0.2, -0.8)};
    @LINE {(0, 3) (0, 1.6)};
    @ARC {(0.3, -0.8) (0.7, -0.3) (0.2, 0)};
    @ARC {(0.3, 0) (0.7, 0.5) (0.2, 0.8)};
    @ARC {(0.3, -1.6) (0.7, -1.1) (0.2, -0.8)};
    @ARC {(0.3, 0.8) (0.7, 1.3) (0.2, 1.6)};
    (0, 3) @PIN(terminal=1, direction="up");
    (0, -3) @PIN(terminal=2, direction="down");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(1.5, 2);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(1.5, 0.5)
  };

  /* p n; variable inductor */
  $VARIABLE_INDUCTOR = @DEFINE-SYMBOL(box=[-2, -3, 2, 3]) {
    @LINE {(0, 1.6) (0.2, 1.6)};
    @LINE {(0, -1.6) (0, -3)};
    @LINE {(0, 0.8) (0.2, 0.8)};
    (0.8, 2.2) @CIRCLE(radius=0.3);
    @LINE {(0, 0) (0.2, 0)};
    @LINE {(0, -1.6) (0.2, -1.6)};
    @LINE {(0, -0.8) (0.2, -0.8)};
    @LINE {(0, 3) (0, 1.6)};
    @ARC {(0.3, -0.8) (0.7, -0.3) (0.2, 0)};
    @ARC {(0.3, 0) (0.7, 0.5) (0.2, 0.8)};
    @ARC {(0.3, -1.6) (0.7, -1.1) (0.2, -0.8)};
    @ARC {(0.3, 0.8) (0.7, 1.3) (0.2, 1.6)};
    @LINE {(-1.5, -1.5) (1.2, 1.2)};
    @LINE(fill="linecolor", linestyle="none") {(1.5, 1.5) (0.8, 1.25) (1.25, 0.8) (1.5, 1.5)};
    (0, 3) @PIN(terminal=1, direction="up");
    (0, -3) @PIN(terminal=2, direction="down");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(1.5, 2);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(1.5, 0.5)
  };

  /* p_plus p_minus s_plus s_minus; transformer */
  $TRANSFORMER = @DEFINE-SYMBOL(box=[-3, -2, 3, 2]) {
    @LINE {(-1.6, -2) (-3, -2)};
    @LINE {(-0.8, 2) (-0.8, 1.8)};
    @LINE {(-0.8, -2) (-0.8, -1.8)};
    @LINE {(-1.6, 2) (-1.6, 1.8)};
    @LINE {(-1.6, -2) (-1.6, -1.8)};
    @LINE {(3, 2) (1.6, 2)};
    (2.2, 0.9) @CIRCLE(radius=0.3);
    @LINE {(0.8, 2) (0.8, 1.8)};
    @LINE {(0, 2) (0, 1.8)};
    @LINE {(1.6, 2) (1.6, 1.8)};
    @LINE {(0, -2) (0, -1.8)};
    @LINE {(1.6, -2) (1.6, -1.8)};
    @LINE {(0.8, -2) (0.8, -1.8)};
    (2.2, -0.9) @CIRCLE(radius=0.3);
    @LINE {(3, -2) (1.6, -2)};
    (0.5, 0) @CIRCLE(radius=0.1);
    (-0.4, 0) @CIRCLE(radius=0.1);
    @LINE {(-1.6, 2) (-3, 2)};
    @ARC {(0.8, 1.7) (1.3, 1.3) (1.6, 1.8)};
    @ARC {(-0.8, 1.7) (-0.3, 1.3) (0, 1.8)};
    @ARC {(0.8, -1.7) (0.7, -1.4) (0.4, -1.3)};
    @ARC {(-1.6, 1.7) (-1.1, 1.3) (-0.8, 1.8)};
    @ARC {(0, -1.7) (-0.1, -1.4) (-0.4, -1.3)};
    @ARC {(1.6, -1.7) (1.5, -1.4) (1.2, -1.3)};
    @ARC {(-0.8, -1.7) (-0.9, -1.4) (-1.2, -1.3)};
    @ARC {(0, 1.7) (0.5, 1.3) (0.8, 1.8)};
    (3, 2) @PIN(terminal=1, direction="right");
    (-3, 2) @PIN(terminal=2, direction="left");
    (3, -2) @PIN(terminal=3, direction="right");
    (-3, -2) @PIN(terminal=4, direction="left");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 2.6);
    ? @TEXT("${value}", key="value", halign="middle") => @PLACE(0, -2.8)
  };

  /* p n; voltage source */
  $VOLTAGE_SOURCE = @DEFINE-SYMBOL(box=[-2, -3, 2, 3]) {
    @LINE {(0, 0.2) (0, 0.8)};
    (0, 0) @CIRCLE(radius=1);
    @LINE {(0.3, 0.5) (-0.3, 0.5)};
    @LINE {(0, 1) (0, 3)};
    @LINE {(0, -1) (0, -3)};
    @LINE {(0.3, -0.5) (-0.3, -0.5)};
    (0, 3) @PIN(terminal=1, direction="up");
    (0, -3) @PIN(terminal=2, direction="down");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(0.5, 2);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(1.5, 0.5)
  };

  /* p n; current source */
  $CURRENT_SOURCE = @DEFINE-SYMBOL(box=[-2, -3, 2, 3]) {
    (0, 0.5) @CIRCLE(radius=1);
    @LINE {(0, -1.5) (0, -3)};
    @LINE {(0, 1.5) (0, 3)};
    @LINE {(0, -1.1) (0.4, -0.6) (-0.4, -0.6) (0, -1.1)};
    @LINE {(0, -1.1) (0, 1.2)};
    (0, -0.5) @CIRCLE(radius=1);
    (0, 3) @PIN(terminal=1, direction="up");
    (0, -3) @PIN(terminal=2, direction="down");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(1, 2);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(1.5, 0.5)
  };

  /* p n; multi-cell DC battery */
  $BATTERY = @DEFINE-SYMBOL(box=[-1.5, -3, 1.5, 3]) {
    @LINE {(0, 3) (0, 0.75)};
    @LINE {(-1.2, 0.75) (1.2, 0.75)};
    @LINE {(-0.6, 0.25) (0.6, 0.25)};
    @LINE {(-1.2, -0.25) (1.2, -0.25)};
    @LINE {(-0.6, -0.75) (0.6, -0.75)};
    @LINE {(0, -0.75) (0, -3)};
    @LINE {(-0.9, 1.4) (-0.5, 1.4)};
    @LINE {(-0.7, 1.2) (-0.7, 1.6)};
    (0, 3) @PIN(terminal=1, direction="up");
    (0, -3) @PIN(terminal=2, direction="down");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(1.4, 1.5);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(1.4, -0.5)
  };

  /* p n (cp) (cn); 2-terminal voltage-controlled voltage source */
  $VCVS = @DEFINE-SYMBOL(box=[-2, -3, 2, 3]) {
    (0, 0) @CIRCLE(radius=1);
    @LINE {(0, -1) (0, -3)};
    @LINE {(0, 1) (0, 3)};
    @LINE {(-0.3, -0.5) (0.3, -0.5)};
    @LINE {(-0.3, 0.5) (0.3, 0.5)};
    @LINE {(0, 0.2) (0, 0.8)};
    (0, 3) @PIN(terminal=1, direction="up");
    (0, -3) @PIN(terminal=2, direction="down");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(1, 2);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(1.5, 0.5)
  };

  /* p n (cp) (cn); 2-terminal voltage-controlled current source */
  $VCCS = @DEFINE-SYMBOL(box=[-2, -3, 2, 3]) {
    @LINE {(0, 1) (0, 3)};
    @LINE {(0.5, 0) (0, -0.5) (-0.5, 0)};
    @LINE {(0, 0.5) (0, -0.5)};
    (0, 0) @CIRCLE(radius=1);
    @LINE {(0, -1) (0, -3)};
    (0, 3) @PIN(terminal=1, direction="up");
    (0, -3) @PIN(terminal=2, direction="down");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(1, 2);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(1.5, 0.5)
  };

  /* p n; current-controlled current source */
  $CCCS = @DEFINE-SYMBOL(box=[-2, -3, 2, 3]) {
    @LINE {(0, 1) (0, 3)};
    @LINE {(0.5, 0) (0, -0.5) (-0.5, 0)};
    @LINE {(0, 0.5) (0, -0.5)};
    (0, 0) @CIRCLE(radius=1);
    @LINE {(0, -1) (0, -3)};
    @LINE {(-1.5, 0.7) (-1.5, -0.7)};
    @LINE {(-1.7, -0.3) (-1.5, -0.7) (-1.3, -0.3)};
    (0, 3) @PIN(terminal=1, direction="up");
    (0, -3) @PIN(terminal=2, direction="down");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(1, 2);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(1.5, 0.5)
  };

  /* p n; current-controlled voltage source */
  $CCVS = @DEFINE-SYMBOL(box=[-2, -3, 2, 3]) {
    (0, 0) @CIRCLE(radius=1);
    @LINE {(0, -1) (0, -3)};
    @LINE {(0, 1) (0, 3)};
    @LINE {(-0.3, -0.5) (0.3, -0.5)};
    @LINE {(-0.3, 0.5) (0.3, 0.5)};
    @LINE {(0, 0.2) (0, 0.8)};
    @LINE {(-1.5, 0.7) (-1.5, -0.7)};
    @LINE {(-1.7, -0.3) (-1.5, -0.7) (-1.3, -0.3)};
    (0, 3) @PIN(terminal=1, direction="up");
    (0, -3) @PIN(terminal=2, direction="down");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(1, 2);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(1.5, 0.5)
  };

  /* p n cp cn; 4-terminal voltage-controlled voltage source */
  $VCVS_4TERM = @DEFINE-SYMBOL(box=[-1, -3, 3, 3]) {
    (1, 0) @CIRCLE(radius=1);
    @LINE {(1, -1) (1, -3)};
    @LINE {(1, 1) (1, 3)};
    @LINE {(-1, 1) (1, 1)};
    @LINE {(-1, -1) (1, -1)};
    @LINE {(0.7, -0.5) (1.3, -0.5)};
    @LINE {(0.7, 0.5) (1.3, 0.5)};
    @LINE {(1, 0.2) (1, 0.8)};
    @LINE {(-0.5, -0.7) (-0.1, -0.7)};
    @LINE {(-0.5, 1.3) (-0.1, 1.3)};
    @LINE {(-0.3, 1.1) (-0.3, 1.5)};
    (1, 3) @PIN(terminal=1, direction="up");
    (1, -3) @PIN(terminal=2, direction="down");
    (-1, 1) @PIN(terminal=3, direction="left");
    (-1, -1) @PIN(terminal=4, direction="left");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(2.2, 2);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(2.5, 0.5)
  };

  /* p n cp cn; 4-terminal voltage-controlled current source */
  $VCCS_4TERM = @DEFINE-SYMBOL(box=[-1, -3, 3, 3]) {
    (1, 0) @CIRCLE(radius=1);
    @LINE {(1.5, 0) (1, -0.5) (0.5, 0)};
    @LINE {(1, -1) (1, -3)};
    @LINE {(-1, 1) (1, 1)};
    @LINE {(-1, -1) (1, -1)};
    @LINE {(1, 0.5) (1, -0.5)};
    @LINE {(1, 1) (1, 3)};
    @LINE {(-0.5, -0.7) (-0.1, -0.7)};
    @LINE {(-0.5, 1.3) (-0.1, 1.3)};
    @LINE {(-0.3, 1.1) (-0.3, 1.5)};
    (1, 3) @PIN(terminal=1, direction="up");
    (1, -3) @PIN(terminal=2, direction="down");
    (-1, 1) @PIN(terminal=3, direction="left");
    (-1, -1) @PIN(terminal=4, direction="left");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(2.2, 2);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(2.5, 0.5)
  };

  /* p n (cp) (cn); open SPST switch */
  $SWITCH = @DEFINE-SYMBOL(box=[-3, -0.2, 3, 1]) {
    @LINE {(-1, 0) (-0.5, 0)};
    (1, 0) @CIRCLE(radius=0.2);
    @LINE {(-0.5, 0) (1, 1)};
    @LINE {(3, 0) (1, 0)};
    @LINE {(-3, 0) (-1, 0)};
    (-0.5, 0) @CIRCLE(radius=0.2);
    (-3, 0) @PIN(terminal=1, direction="left");
    (3, 0) @PIN(terminal=2, direction="right");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 1.5);
    ? @TEXT("${value}", key="value", halign="middle") => @PLACE(0, -1.2)
  };

  /* p n (cp) (cn); closed SPST switch */
  $CLOSED_SWITCH = @DEFINE-SYMBOL(box=[-3, -0.2, 3, 1]) {
    @LINE {(-1, 0) (-0.5, 0)};
    (1, 0) @CIRCLE(radius=0.2);
    @LINE {(-0.5, 0) (1, 0.2)};
    @LINE {(3, 0) (1, 0)};
    @LINE {(-3, 0) (-1, 0)};
    (-0.5, 0) @CIRCLE(radius=0.2);
    (-3, 0) @PIN(terminal=1, direction="left");
    (3, 0) @PIN(terminal=2, direction="right");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 1.5);
    ? @TEXT("${value}", key="value", halign="middle") => @PLACE(0, -1.2)
  };

  /* p n cp (cn); 3-terminal externally controlled switch */
  $EXTERNALLY_CONTROLLED_SWITCH = @DEFINE-SYMBOL(box=[-3, -3, 1, 3]) {
    @LINE {(0, 3) (0, 1)};
    @LINE {(-1, -1) (0, 1)};
    @LINE {(0, -1) (0, -3)};
    @LINE {(-3, 0) (-0.8, 0)};
    @LINE {(-1.3, 0.3) (-0.8, 0) (-1.3, -0.3)};
    (0, 3) @PIN(terminal=1, direction="up");
    (0, -3) @PIN(terminal=2, direction="down");
    (-3, 0) @PIN(terminal=3, direction="left");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(1, 1.5);
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(1, -0.5)
  };

  /* p n cp cn; 4-terminal voltage-controlled switch */
  $VOLTAGE_CONTROLLED_SWITCH = @DEFINE-SYMBOL(box=[-3, -2, 3, 3]) {
    @LINE {(3, -2) (1.5, -2) (1.5, 0.5)};
    @LINE {(-3, 2) (-1, 2)};
    @LINE {(-1.5, 0.5) (-1.5, -2) (-3, -2)};
    @LINE {(1, 3) (-1, 2)};
    @LINE {(1, 2) (3, 2)};
    @ARC {(-1.5, 0.5) (-1, 1) (-0.5, 0.5)};
    @ARC {(-0.5, 0.5) (0, 1) (0.5, 0.5)};
    @ARC {(0.5, 0.5) (1, 1) (1.5, 0.5)};
    (-3, 2) @PIN(terminal=1, direction="left");
    (3, 2) @PIN(terminal=2, direction="right");
    (-3, -2) @PIN(terminal=3, direction="left");
    (3, -2) @PIN(terminal=4, direction="right");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 3.5);
    ? @TEXT("${value}", key="value", halign="middle") => @PLACE(0, -3.2)
  };

  /* draws $SPDT_SWITCH; com a b */
  $SPDT_SWITCH_SYMBOL = @DEFINE-SYMBOL(box=[-3, -2, 3, 2]) {
    @LINE {(-1, 1) (-0.5, 1)};
    (1, 2) @CIRCLE(radius=0.2);
    @LINE {(-0.5, 1) (1, 2)};
    @LINE {(3, 2) (1, 2)};
    @LINE {(3, -1) (1, -1)};
    @LINE {(-3, 1) (-1, 1)};
    (1, -1) @CIRCLE(radius=0.2);
    (-0.5, 1) @CIRCLE(radius=0.2);
    (-3, 1) @PIN(terminal=1, direction="left");
    (3, 2) @PIN(terminal=2, direction="right");
    (3, -1) @PIN(terminal=3, direction="right");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 2.6);
    ? @TEXT("${value}", key="value", halign="middle") => @PLACE(0, -2.2)
  };

  /* draws $GROUND; p */
  $GROUND_SYMBOL = @DEFINE-SYMBOL(box=[-1, -4, 1, 0]) {
    @LINE {(-1, -3) (1, -3) (0, -4) (-1, -3)};
    @LINE {(0, 0) (0, -3)};
    (0, 0) @PIN(terminal=1, direction="up")
  };

  /* draws $SUPPLY; p */
  $SUPPLY_SYMBOL = @DEFINE-SYMBOL(box=[-2.5, 0, 2.5, 5]) {
    @LINE {(0, 0) (0, 4)};
    @LINE {(-2.5, 4) (2.5, 4)};
    (0, 0) @PIN(terminal=1, direction="down");
    ? @TEXT("${p}", key="name", halign="middle") => @PLACE(0, 5.5)
  };

  /* draws $IO_PORT; p */
  $IO_PORT_SYMBOL = @DEFINE-SYMBOL(box=[-2.8, -1, 0, 1]) {
    @LINE(fill="linecolor", linestyle="none") {(0, 0) (-0.9, -0.9) (-1.9, -0.9) (-2.8, 0) (-1.9, 0.9) (-0.9, 0.9) (0, 0)};
    (0, 0) @PIN(terminal=1, direction="right");
    ? @TEXT("${p}", key="name", halign="end", valign="middle") => @PLACE(-3.2, 0)
  };

  /* p n; behavioral source */
  $BEHAVIORAL_SOURCE = @DEFINE-SYMBOL(box=[-1.5, -3, 1.5, 3]) {
    (0, 0) @CIRCLE(radius=1.2);
    @LINE {(0, 1.2) (0, 3)};
    @LINE {(0, -1.2) (0, -3)};
    @LINE {(-0.25, 0.7) (0.25, 0.7)};
    @LINE {(0, 0.45) (0, 0.95)};
    @LINE {(-0.25, -0.7) (0.25, -0.7)};
    (0, 3) @PIN(terminal=1, direction="up");
    (0, -3) @PIN(terminal=2, direction="down");
    (0, 0) @TEXT("B", halign="middle", valign="middle", size=0.9);
