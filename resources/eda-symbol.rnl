  };

  /* voltage-controlled oscillator */
  $VCO = @DEFINE-SYMBOL(box=[-4, -4, 5, 4]) {
    (0, 0) @CIRCLE(radius=2);
    @LINE {(-4, 4) (0, 4) (0, 2)};
    @LINE {(-4, -4) (0, -4) (0, -2)};
    @LINE {(2, 0) (5, 0)};
    (-4, 4) @PIN(terminal=1, direction="left");
    (-4, -4) @PIN(terminal=2, direction="left");
    (5, 0) @PIN(terminal=3, direction="right");
    ? @TEXT("${value}", key="value", halign="start") => @PLACE(3, -2);
    (0, 0) @TEXT("VCO", halign="middle", valign="middle", size=0.8);
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(0.5, 3.1)
  };

  /* clocked JK flip-flop */
  $JK_FF = @DEFINE-SYMBOL(box=[-8, -5, 8, 5]) {
    @RECTANGLE {(-4, -5) (4, 5)};
    (4.5, -3) @CIRCLE(radius=0.5);
    @LINE {(8, 3) (4, 3)};
    @LINE {(5, -3) (8, -3)};
    @LINE {(-8, 3) (-4, 3)};
    @LINE {(-8, 0) (-4, 0)};
    @LINE {(-8, -3) (-4, -3)};
    (-8, -3) @PIN(terminal=1, direction="left");
    (-8, 0) @PIN(terminal=2, direction="left");
    (-8, 3) @PIN(terminal=3, direction="left");
    (8, 3) @PIN(terminal=4, direction="right");
    (8, -3) @PIN(terminal=5, direction="right");
    (2.8, -3.4) @TEXT("Q-", halign="middle", valign="baseline", size=1);
    (-3, -3.4) @TEXT("J", halign="middle", valign="baseline", size=1);
    (-2.8, -0.6) @TEXT("K", halign="middle", valign="baseline", size=1);
    (2.8, 2.4) @TEXT("Q", halign="middle", valign="baseline", size=1);
    (-2.2, 2.4) @TEXT("CLK", halign="middle", valign="baseline", size=1);
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(-4, 6);
    ? @TEXT("${value}", key="value", halign="middle") => @PLACE(0, 2.2)
  };

  /* 3-port RF mixer */
  $MIXER = @DEFINE-SYMBOL(box=[-8, -4, 8, 8.2]) {
    @LINE {(-3, 1.2) (3, 6.8)};
    @LINE {(-3, 6.8) (3, 1.2)};
    (0, 4) @CIRCLE(radius=4.2);
    @LINE {(0, -0.2) (0, -4)};
    @LINE {(8, 4) (4.2, 4)};
    @LINE {(-8, 4) (-4.2, 4)};
    (-8, 4) @PIN(terminal=1, direction="left");
    (0, -4) @PIN(terminal=2, direction="down");
    (8, 4) @PIN(terminal=3, direction="right");
    ? @TEXT("${name}", key="name", halign="end") => @PLACE(7.5, 7.2)
  };

  /* 1-port RF oscillator */
  $OSC = @DEFINE-SYMBOL(box=[-4.2, -12.2, 4.2, 0]) {
    @LINE {(0, -3.8) (0, 0)};
    (0, -8) @CIRCLE(radius=4.2);
    @ARC {(0, -8) (-1.5, -5) (-3, -8)};
    @ARC {(0, -8) (1.5, -11) (3, -8)};
    (0, 0) @PIN(terminal=1, direction="up");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(-5, -3.3)
  };

  /* 4-port 90-degree quadrature hybrid */
  $QUADRATURE = @DEFINE-SYMBOL(box=[-4.2, -8, 4.2, 8]) {
    @LINE {(0, 4.2) (0, 8)};
    @LINE {(0, -4.2) (0, -8)};
    (0, 0) @CIRCLE(radius=4.2);
    @LINE {(-2.7, -2.9) (-2.4, -2.7) (-2.2, -2.4) (-2, -2) (-1.8, -1.5) (-1.6, -0.5) (-1.6, 0)};
    @LINE {(2.9, -3) (2.5, -2.9) (2.2, -2.6) (1.9, -2.2) (1.7, -1.7) (1.5, -1.1) (1.4, -0.4) (1.4, 0.1)};
    @ARC {(0, 0) (-1.5, 3) (-3, 0)};
    @ARC {(1.4, 0) (-0.1, 3) (-1.6, 0)};
    @ARC {(0, 0) (1.5, -3) (3, 0)};
    (0, 8) @PIN(terminal=1, direction="up");
    (0, -8) @PIN(terminal=2, direction="down");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(-5, 4.7)
  };

  /* 2-port low-pass filter */
  $LOWPASS_FILTER = @DEFINE-SYMBOL(box=[-7, -2.7, 7, 2.4]) {
    @LINE {(-0.2, 2.2) (0.4, 0.8)};
    @LINE {(-0.2, 0.7) (0.4, -0.7)};
    @LINE {(-3.7, 0) (-7, 0)};
    @RECTANGLE {(-3.7, -2.7) (3.8, 2.4)};
    @LINE {(7, 0) (3.8, 0)};
    @ARC {(0.1, 1.5) (1.3, 1) (2.5, 1.5)};
    @ARC {(0.1, 0) (1.3, -0.5) (2.5, 0)};
    @ARC {(0.1, 0) (-1.1, 0.5) (-2.3, 0)};
    @ARC {(0.1, 1.5) (-1.1, 2) (-2.3, 1.5)};
    @ARC {(0.1, -1.5) (-1.1, -1) (-2.3, -1.5)};
    @ARC {(0.1, -1.5) (1.3, -2) (2.5, -1.5)};
    (-7, 0) @PIN(terminal=1, direction="left");
    (7, 0) @PIN(terminal=2, direction="right");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0.1, 3.2)
  };

  /* 2-port high-pass filter */
  $HIGHPASS_FILTER = @DEFINE-SYMBOL(box=[-7, -2.7, 7, 2.4]) {
    @LINE {(-0.3, 0.7) (0.3, -0.7)};
    @LINE {(-0.3, -0.8) (0.3, -2.2)};
    @LINE {(-3.7, 0) (-7, 0)};
    @RECTANGLE {(-3.7, -2.7) (3.8, 2.4)};
    @LINE {(7, 0) (3.8, 0)};
    @ARC {(0, 1.5) (1.2, 1) (2.4, 1.5)};
    @ARC {(0, 0) (1.2, -0.5) (2.4, 0)};
    @ARC {(0, 0) (-1.2, 0.5) (-2.4, 0)};
    @ARC {(0, 1.5) (-1.2, 2) (-2.4, 1.5)};
    @ARC {(0, -1.5) (-1.2, -1) (-2.4, -1.5)};
    @ARC {(0, -1.5) (1.2, -2) (2.4, -1.5)};
    (-7, 0) @PIN(terminal=1, direction="left");
    (7, 0) @PIN(terminal=2, direction="right");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 3.2)
  };

  /* 2-port band-pass filter */
  $BANDPASS_FILTER = @DEFINE-SYMBOL(box=[-7, -2.7, 7, 2.4]) {
    @LINE {(-0.3, -0.8) (0.3, -2.2)};
    @LINE {(-3.7, 0) (-7, 0)};
    @LINE {(-0.3, 2.2) (0.3, 0.8)};
    @RECTANGLE {(-3.7, -2.7) (3.8, 2.4)};
    @LINE {(7, 0) (3.8, 0)};
    @ARC {(0, 0) (-1.2, 0.5) (-2.4, 0)};
    @ARC {(0, 0) (1.2, -0.5) (2.4, 0)};
    @ARC {(0, -1.5) (-1.2, -1) (-2.4, -1.5)};
    @ARC {(0, -1.5) (1.2, -2) (2.4, -1.5)};
    @ARC {(0, 1.5) (1.2, 1) (2.4, 1.5)};
    @ARC {(0, 1.5) (-1.2, 2) (-2.4, 1.5)};
    (-7, 0) @PIN(terminal=1, direction="left");
    (7, 0) @PIN(terminal=2, direction="right");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 3.3)
  };

  /* 2-port band-stop filter */
  $BANDSTOP_FILTER = @DEFINE-SYMBOL(box=[-7, -2.7, 7, 2.4]) {
    @LINE {(-3.7, 0) (-7, 0)};
    @LINE {(-0.3, 0.7) (0.3, -0.7)};
    @RECTANGLE {(-3.7, -2.7) (3.8, 2.4)};
    @LINE {(7, 0) (3.8, 0)};
    @ARC {(0, 1.5) (1.2, 1) (2.4, 1.5)};
    @ARC {(0, 0) (1.2, -0.5) (2.4, 0)};
    @ARC {(0, 1.5) (-1.2, 2) (-2.4, 1.5)};
    @ARC {(0, -1.5) (-1.2, -1) (-2.4, -1.5)};
    @ARC {(0, -1.5) (1.2, -2) (2.4, -1.5)};
    @ARC {(0, 0) (-1.2, 0.5) (-2.4, 0)};
    (-7, 0) @PIN(terminal=1, direction="left");
    (7, 0) @PIN(terminal=2, direction="right");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.1, 3.3)
  };

  /* chassis ground */
  $CGND = @DEFINE-SYMBOL(box=[-1, -4, 0.7, 0]) {
    @LINE {(0, 0) (0, -3)};
    @LINE {(-0.7, -3) (0.7, -3)};
    @LINE {(-0.7, -3) (-1, -4)};
    @LINE {(0, -3) (-0.2, -4)};
    @LINE {(0.7, -3) (0.5, -4)};
    (0, 0) @PIN(terminal=1, direction="up");
    ? @TEXT("${name}", key="name", halign="middle", valign="top") => @PLACE(-0.15, -4.5)
  };

  /* earth ground */
  $EGND = @DEFINE-SYMBOL(box=[-0.7, -4, 0.7, 0]) {
    @LINE {(0, 0) (0, -3)};
    @LINE {(-0.7, -3) (0.7, -3)};
    @LINE {(-0.5, -3.5) (0.5, -3.5)};
    @LINE {(-0.2, -4) (0.2, -4)};
    (0, 0) @PIN(terminal=1, direction="up");
    ? @TEXT("${name}", key="name", halign="middle", valign="top") => @PLACE(0, -4.5)
  };

  /* negative supply bar */
  $VSS_SYMBOL = @DEFINE-SYMBOL(box=[-2.5, -5, 2.5, 0]) {
    @LINE {(-2.5, -4) (2.5, -4)};
    @LINE {(0, 0) (0, -4)};
    (0, 0) @PIN(terminal=1, direction="up");
    ? @TEXT("${name}", key="name", halign="middle", valign="top") => @PLACE(0, -5.5);
    (1, -3) @TEXT("vss", halign="start", valign="baseline", size=0.7)
  };

  /* power arrow */
  $PWR = @DEFINE-SYMBOL(box=[-0.5, 0, 0.5, 4.5]) {
    @LINE {(-0.5, 3) (0.5, 3) (0, 4.5) (-0.5, 3)};
    @LINE {(0, 0) (0, 3)};
    (0, 0) @PIN(terminal=1, direction="down");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 5.1)
  };

  /* schematic input pin */
  $IPIN = @DEFINE-SYMBOL(box=[-2, -1, 0, 1]) {
    @LINE(fill="linecolor", linestyle="none") {(-2, -0.9) (-2, 0.9) (-0.9, 0.9) (0, 0) (-0.9, -0.9) (-2, -0.9)};
    (0, 0) @PIN(terminal=1, direction="right");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-1, 1.6)
  };

  /* schematic output pin */
  $OPIN = @DEFINE-SYMBOL(box=[0, -1, 2, 1]) {
    @LINE(fill="linecolor", linestyle="none") {(0, -0.9) (0, 0.9) (1.1, 0.9) (2, 0) (1.1, -0.9) (0, -0.9)};
    (0, 0) @PIN(terminal=1, direction="left");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(1, 1.6)
  };

  /* on-page connector */
  $ON_PAGE_CONN = @DEFINE-SYMBOL(box=[-1, -5, 1, 0]) {
    (0, -4) @CIRCLE(radius=1);
    @LINE {(0, 0) (0, -3)};
    (0, 0) @PIN(terminal=1, direction="up");
    ? @TEXT("${name}", key="name", halign="middle", valign="top") => @PLACE(0, -5.5)
  };
}

/* ---------------------------------------------------------------- Usage rules and instance selection rules */
@RNL {
  /* Virtual element and mark usage rules */
  # @SELECT-USAGE $GROUND => @SET-SYMBOL $GROUND_SYMBOL;
  # @SELECT-USAGE $SUPPLY => @SET-SYMBOL $SUPPLY_SYMBOL;
  # @SELECT-USAGE $IO_PORT => @SET-SYMBOL $IO_PORT_SYMBOL;
  # @SELECT-USAGE $NO_CONNECT => @SET-SYMBOL $NO_CONNECT_SYMBOL;
