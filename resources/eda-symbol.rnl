    ? @TEXT("${value}", key="value", halign="start") => @PLACE(3, -2);
    (0, 0) @TEXT("VCO", halign="middle", valign="middle", size=0.8);
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(0.5, 3.1)
  };

  /* clocked JK flip-flop */
  $JK_FF = @DEFINE-SYMBOL(box=[-8, -5, 8, 5]) {
    @RECTANGLE {(-4, -5) (4, 5)};
    (4.5, -3) @CIRCLE(radius=0.5);
    @LINE {(8, 3) (4, 3)};
    @LINE {(5, -3) (8, -3)};
    @LINE {(-8, 3) (-4, 3)};
    @LINE {(-8, 0) (-4, 0)};
    @LINE {(-8, -3) (-4, -3)};
    (-8, -3) @PIN(terminal=1, direction="left");
    (-8, 0) @PIN(terminal=2, direction="left");
    (-8, 3) @PIN(terminal=3, direction="left");
    (8, 3) @PIN(terminal=4, direction="right");
    (8, -3) @PIN(terminal=5, direction="right");
    (2.8, -3.4) @TEXT("Q-", halign="middle", valign="baseline", size=1);
    (-3, -3.4) @TEXT("J", halign="middle", valign="baseline", size=1);
    (-2.8, -0.6) @TEXT("K", halign="middle", valign="baseline", size=1);
    (2.8, 2.4) @TEXT("Q", halign="middle", valign="baseline", size=1);
    (-2.2, 2.4) @TEXT("CLK", halign="middle", valign="baseline", size=1);
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(-4, 6);
    ? @TEXT("${value}", key="value", halign="middle") => @PLACE(0, 2.2)
  };

  /* 3-port RF mixer */
  $MIXER = @DEFINE-SYMBOL(box=[-8, -4, 8, 8.2]) {
    @LINE {(-3, 1.2) (3, 6.8)};
    @LINE {(-3, 6.8) (3, 1.2)};
    (0, 4) @CIRCLE(radius=4.2);
    @LINE {(0, -0.2) (0, -4)};
    @LINE {(8, 4) (4.2, 4)};
    @LINE {(-8, 4) (-4.2, 4)};
    (-8, 4) @PIN(terminal=1, direction="left");
    (0, -4) @PIN(terminal=2, direction="down");
    (8, 4) @PIN(terminal=3, direction="right");
    ? @TEXT("${name}", key="name", halign="end") => @PLACE(7.5, 7.2)
  };

  /* 1-port RF oscillator */
  $OSC = @DEFINE-SYMBOL(box=[-4.2, -12.2, 4.2, 0]) {
    @LINE {(0, -3.8) (0, 0)};
    (0, -8) @CIRCLE(radius=4.2);
    @ARC {(0, -8) (-1.5, -5) (-3, -8)};
    @ARC {(0, -8) (1.5, -11) (3, -8)};
    (0, 0) @PIN(terminal=1, direction="up");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(-5, -3.3)
  };

  /* 4-port 90-degree quadrature hybrid */
  $QUADRATURE = @DEFINE-SYMBOL(box=[-4.2, -8, 4.2, 8]) {
    @LINE {(0, 4.2) (0, 8)};
    @LINE {(0, -4.2) (0, -8)};
    (0, 0) @CIRCLE(radius=4.2);
    @LINE {(-2.7, -2.9) (-2.4, -2.7) (-2.2, -2.4) (-2, -2) (-1.8, -1.5) (-1.6, -0.5) (-1.6, 0)};
    @LINE {(2.9, -3) (2.5, -2.9) (2.2, -2.6) (1.9, -2.2) (1.7, -1.7) (1.5, -1.1) (1.4, -0.4) (1.4, 0.1)};
    @ARC {(0, 0) (-1.5, 3) (-3, 0)};
    @ARC {(1.4, 0) (-0.1, 3) (-1.6, 0)};
    @ARC {(0, 0) (1.5, -3) (3, 0)};
    (0, 8) @PIN(terminal=1, direction="up");
    (0, -8) @PIN(terminal=2, direction="down");
    ? @TEXT("${name}", key="name", halign="start") => @PLACE(-5, 4.7)
  };

  /* 2-port low-pass filter */
  $LOWPASS_FILTER = @DEFINE-SYMBOL(box=[-7, -2.7, 7, 2.4]) {
    @LINE {(-0.2, 2.2) (0.4, 0.8)};
    @LINE {(-0.2, 0.7) (0.4, -0.7)};
    @LINE {(-3.7, 0) (-7, 0)};
    @RECTANGLE {(-3.7, -2.7) (3.8, 2.4)};
    @LINE {(7, 0) (3.8, 0)};
    @ARC {(0.1, 1.5) (1.3, 1) (2.5, 1.5)};
    @ARC {(0.1, 0) (1.3, -0.5) (2.5, 0)};
    @ARC {(0.1, 0) (-1.1, 0.5) (-2.3, 0)};
    @ARC {(0.1, 1.5) (-1.1, 2) (-2.3, 1.5)};
    @ARC {(0.1, -1.5) (-1.1, -1) (-2.3, -1.5)};
    @ARC {(0.1, -1.5) (1.3, -2) (2.5, -1.5)};
    (-7, 0) @PIN(terminal=1, direction="left");
    (7, 0) @PIN(terminal=2, direction="right");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0.1, 3.2)
  };

  /* 2-port high-pass filter */
  $HIGHPASS_FILTER = @DEFINE-SYMBOL(box=[-7, -2.7, 7, 2.4]) {
    @LINE {(-0.3, 0.7) (0.3, -0.7)};
    @LINE {(-0.3, -0.8) (0.3, -2.2)};
    @LINE {(-3.7, 0) (-7, 0)};
    @RECTANGLE {(-3.7, -2.7) (3.8, 2.4)};
    @LINE {(7, 0) (3.8, 0)};
    @ARC {(0, 1.5) (1.2, 1) (2.4, 1.5)};
    @ARC {(0, 0) (1.2, -0.5) (2.4, 0)};
    @ARC {(0, 0) (-1.2, 0.5) (-2.4, 0)};
    @ARC {(0, 1.5) (-1.2, 2) (-2.4, 1.5)};
    @ARC {(0, -1.5) (-1.2, -1) (-2.4, -1.5)};
    @ARC {(0, -1.5) (1.2, -2) (2.4, -1.5)};
    (-7, 0) @PIN(terminal=1, direction="left");
    (7, 0) @PIN(terminal=2, direction="right");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 3.2)
  };

  /* 2-port band-pass filter */
  $BANDPASS_FILTER = @DEFINE-SYMBOL(box=[-7, -2.7, 7, 2.4]) {
    @LINE {(-0.3, -0.8) (0.3, -2.2)};
    @LINE {(-3.7, 0) (-7, 0)};
    @LINE {(-0.3, 2.2) (0.3, 0.8)};
    @RECTANGLE {(-3.7, -2.7) (3.8, 2.4)};
    @LINE {(7, 0) (3.8, 0)};
    @ARC {(0, 0) (-1.2, 0.5) (-2.4, 0)};
    @ARC {(0, 0) (1.2, -0.5) (2.4, 0)};
    @ARC {(0, -1.5) (-1.2, -1) (-2.4, -1.5)};
    @ARC {(0, -1.5) (1.2, -2) (2.4, -1.5)};
    @ARC {(0, 1.5) (1.2, 1) (2.4, 1.5)};
    @ARC {(0, 1.5) (-1.2, 2) (-2.4, 1.5)};
    (-7, 0) @PIN(terminal=1, direction="left");
    (7, 0) @PIN(terminal=2, direction="right");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 3.3)
  };

  /* 2-port band-stop filter */
  $BANDSTOP_FILTER = @DEFINE-SYMBOL(box=[-7, -2.7, 7, 2.4]) {
    @LINE {(-3.7, 0) (-7, 0)};
    @LINE {(-0.3, 0.7) (0.3, -0.7)};
    @RECTANGLE {(-3.7, -2.7) (3.8, 2.4)};
    @LINE {(7, 0) (3.8, 0)};
    @ARC {(0, 1.5) (1.2, 1) (2.4, 1.5)};
    @ARC {(0, 0) (1.2, -0.5) (2.4, 0)};
    @ARC {(0, 1.5) (-1.2, 2) (-2.4, 1.5)};
    @ARC {(0, -1.5) (-1.2, -1) (-2.4, -1.5)};
    @ARC {(0, -1.5) (1.2, -2) (2.4, -1.5)};
    @ARC {(0, 0) (-1.2, 0.5) (-2.4, 0)};
    (-7, 0) @PIN(terminal=1, direction="left");
    (7, 0) @PIN(terminal=2, direction="right");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.1, 3.3)
  };

  /* chassis ground */
  $CGND = @DEFINE-SYMBOL(box=[-1, -4, 0.7, 0]) {
    @LINE {(0, 0) (0, -3)};
    @LINE {(-0.7, -3) (0.7, -3)};
    @LINE {(-0.7, -3) (-1, -4)};
    @LINE {(0, -3) (-0.2, -4)};
    @LINE {(0.7, -3) (0.5, -4)};
    (0, 0) @PIN(terminal=1, direction="up");
    ? @TEXT("${name}", key="name", halign="middle", valign="top") => @PLACE(-0.15, -4.5)
  };

  /* earth ground */
  $EGND = @DEFINE-SYMBOL(box=[-0.7, -4, 0.7, 0]) {
    @LINE {(0, 0) (0, -3)};
    @LINE {(-0.7, -3) (0.7, -3)};
    @LINE {(-0.5, -3.5) (0.5, -3.5)};
    @LINE {(-0.2, -4) (0.2, -4)};
    (0, 0) @PIN(terminal=1, direction="up");
    ? @TEXT("${name}", key="name", halign="middle", valign="top") => @PLACE(0, -4.5)
  };

  /* negative supply bar */
  $VSS_SYMBOL = @DEFINE-SYMBOL(box=[-2.5, -5, 2.5, 0]) {
    @LINE {(-2.5, -4) (2.5, -4)};
    @LINE {(0, 0) (0, -4)};
    (0, 0) @PIN(terminal=1, direction="up");
    ? @TEXT("${name}", key="name", halign="middle", valign="top") => @PLACE(0, -5.5);
    (1, -3) @TEXT("vss", halign="start", valign="baseline", size=0.7)
  };

  /* power arrow */
  $PWR = @DEFINE-SYMBOL(box=[-0.5, 0, 0.5, 4.5]) {
    @LINE {(-0.5, 3) (0.5, 3) (0, 4.5) (-0.5, 3)};
    @LINE {(0, 0) (0, 3)};
    (0, 0) @PIN(terminal=1, direction="down");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 5.1)
  };

  /* schematic input pin */
  $IPIN = @DEFINE-SYMBOL(box=[-2, -1, 0, 1]) {
    @LINE(fill="linecolor", linestyle="none") {(-2, -0.9) (-2, 0.9) (-0.9, 0.9) (0, 0) (-0.9, -0.9) (-2, -0.9)};
    %pin = (0, 0) @PIN(terminal="p", direction="right");
    ? @TEXT("${p}", key="netname", halign="middle") => @PLACE(-1, 1.6)
  };

  /* schematic output pin */
  $OPIN = @DEFINE-SYMBOL(box=[0, -1, 2, 1]) {
    @LINE(fill="linecolor", linestyle="none") {(0, -0.9) (0, 0.9) (1.1, 0.9) (2, 0) (1.1, -0.9) (0, -0.9)};
    %pin = (0, 0) @PIN(terminal="p", direction="left");
    ? @TEXT("${p}", key="netname", halign="middle") => @PLACE(1, 1.6)
  };

  /* on-page connector */
  $ON_PAGE_CONN = @DEFINE-SYMBOL(box=[-1, -5, 1, 0]) {
    (0, -4) @CIRCLE(radius=1);
    @LINE {(0, 0) (0, -3)};
    (0, 0) @PIN(terminal=1, direction="up");
    ? @TEXT("${name}", key="name", halign="middle", valign="top") => @PLACE(0, -5.5)
  };
}

/* ---------------------------------------------------------------- Usage rules */
@RNL {
  /* Virtual parts and marks of the standard series 0.4 */
  # @SELECT-USAGE(recursive=true) $GROUND => @SET-SYMBOL $GROUND_SYMBOL;
  # @SELECT-USAGE(recursive=true) $SUPPLY => @SET-SYMBOL $SUPPLY_SYMBOL;
  # @SELECT-USAGE(recursive=true) $IO_PORT => @SET-SYMBOL $IO_PORT_SYMBOL;
  # @SELECT-USAGE(recursive=true) $NO_CONNECT => @SET-SYMBOL $NO_CONNECT_SYMBOL;
  # @SELECT-USAGE(recursive=true) $JUNCTION => @SET-SYMBOL $JUNCTION_SYMBOL;
  # @SELECT-USAGE(recursive=true) $CURRENT_ARROW => @SET-SYMBOL $ARROW_SYMBOL;
  # @SELECT-USAGE(recursive=true) $ARROW => @SET-SYMBOL $ARROW_SYMBOL;
  # @SELECT-USAGE(recursive=true) $SPDT_SWITCH => @SET-SYMBOL $SPDT_SWITCH_SYMBOL;
  # @SELECT-USAGE(recursive=true) $ADDER => @SET-SYMBOL $ADDER_SYMBOL;
  # @SELECT-USAGE(recursive=true) $MULTIPLIER => @SET-SYMBOL $MULTIPLIER_SYMBOL;
  # @SELECT-USAGE(recursive=true) $INTEGRATOR => @SET-SYMBOL $INTEGRATOR_SYMBOL;
  # @SELECT-USAGE(recursive=true) $DISCRETE_TIME_INTEGRATOR => @SET-SYMBOL $DISCRETE_TIME_INTEGRATOR_SYMBOL;
  # @SELECT-USAGE(recursive=true) $QUANTIZER => @SET-SYMBOL $QUANTIZER_SYMBOL;
  # @SELECT-USAGE(recursive=true) $UNIT_DELAY => @SET-SYMBOL $UNIT_DELAY_SYMBOL
}

/* ---------------------------------------------------------------- SPICE element letter rules: only for SPICE sections (2.8), never for Spectre instance names */
@RNL(language="spice") {
  /* SPICE element letter rules */
  # @SELECT-INSTANCE(name="R*", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $RESISTOR;
  # @SELECT-INSTANCE(name="C*", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $CAPACITOR;
  # @SELECT-INSTANCE(name="L*", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $INDUCTOR;
  # @SELECT-INSTANCE(name="V*", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $VOLTAGE_SOURCE;
  # @SELECT-INSTANCE(name="I*", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $CURRENT_SOURCE;
  # @SELECT-INSTANCE(name="D*", recursive=true) => @SET-SYMBOL(terminals=["a", "k"]) $DIODE;
  # @SELECT-INSTANCE(name="E*", recursive=true) => @SET-SYMBOL(terminals=["p", "n", "cp", "cn"]) $VCVS_4TERM;
  # @SELECT-INSTANCE(name="G*", recursive=true) => @SET-SYMBOL(terminals=["p", "n", "cp", "cn"]) $VCCS_4TERM;
  # @SELECT-INSTANCE(name="F*", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $CONTROLLED_CURRENT_SOURCE;
  # @SELECT-INSTANCE(name="H*", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $CONTROLLED_VOLTAGE_SOURCE;
  # @SELECT-INSTANCE(name="B*", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $BEHAVIORAL_SOURCE;
  # @SELECT-INSTANCE(name="S*", recursive=true) => @SET-SYMBOL(terminals=["p", "n", "cp", "cn"]) $VOLTAGE_CONTROLLED_SWITCH;
  # @SELECT-INSTANCE(name="W*", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $SWITCH;
  # @SELECT-INSTANCE(name="T*", recursive=true) => @SET-SYMBOL(terminals=["p1", "n1", "p2", "n2"]) $TRANSMISSION_LINE;
  # @SELECT-INSTANCE(name="O*", recursive=true) => @SET-SYMBOL(terminals=["p1", "n1", "p2", "n2"]) $TRANSMISSION_LINE;
  # @SELECT-INSTANCE(name="U*", recursive=true) => @SET-SYMBOL(terminals=["a", "b", "ref"]) $RC_LINE
}

/* ---------------------------------------------------------------- Instance selection rules */
@RNL {
  /* Spectre primitive and functional-model rules (consolidating label-only and alias models). Instance rules list the terminals in node order, so a symbol binds by position as in 0.1 (11.3). */
  # @SELECT-INSTANCE(model="resistor", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $RESISTOR;
  # @SELECT-INSTANCE(model="res", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $RESISTOR;
  # @SELECT-INSTANCE(model="phyres", recursive=true) => @SET-SYMBOL(terminals=["a", "b", "ref"]) $RC_LINE;
  # @SELECT-INSTANCE(model="vcres", recursive=true) => @SET-SYMBOL $VCRES;
  # @SELECT-INSTANCE(model="capacitor", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $CAPACITOR;
  # @SELECT-INSTANCE(model="cap", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $CAPACITOR;
  # @SELECT-INSTANCE(model="capq", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $CAPACITOR;
  # @SELECT-INSTANCE(model="dcblock", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $CAPACITOR;
  # @SELECT-INSTANCE(model="vccap", recursive=true) => @SET-SYMBOL $VCCAP;
  # @SELECT-INSTANCE(model="inductor", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $INDUCTOR;
  # @SELECT-INSTANCE(model="ind", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $INDUCTOR;
  # @SELECT-INSTANCE(model="indq", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $INDUCTOR;
  # @SELECT-INSTANCE(model="dcfeed", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $INDUCTOR;
  # @SELECT-INSTANCE(model="winding", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $INDUCTOR;
  # @SELECT-INSTANCE(model="transformer", recursive=true) => @SET-SYMBOL(terminals=["p1", "n1", "p2", "n2"]) $TRANSFORMER;
  # @SELECT-INSTANCE(model="xfmr", recursive=true) => @SET-SYMBOL(terminals=["p1", "n1", "p2", "n2"]) $TRANSFORMER;
  # @SELECT-INSTANCE(model="ixfmr", recursive=true) => @SET-SYMBOL(terminals=["p1", "n1", "p2", "n2"]) $TRANSFORMER;
  # @SELECT-INSTANCE(model="ideal_balun", recursive=true) => @SET-SYMBOL $IDEAL_BALUN;
  # @SELECT-INSTANCE(model="balun", recursive=true) => @SET-SYMBOL $IDEAL_BALUN;
  # @SELECT-INSTANCE(model="vsource", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $VOLTAGE_SOURCE;
  # @SELECT-INSTANCE(model="vdc", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $VOLTAGE_SOURCE;
  # @SELECT-INSTANCE(model="isource", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $CURRENT_SOURCE;
  # @SELECT-INSTANCE(model="idc", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $CURRENT_SOURCE;
  # @SELECT-INSTANCE(model="vsin", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $VSIN;
  # @SELECT-INSTANCE(model="vsffm", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $VSIN;
  # @SELECT-INSTANCE(model="vam", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $VSIN;
  # @SELECT-INSTANCE(model="isin", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $ISIN;
  # @SELECT-INSTANCE(model="isffm", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $ISIN;
  # @SELECT-INSTANCE(model="iam", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $ISIN;
  # @SELECT-INSTANCE(model="vpulse", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $VPULSE;
  # @SELECT-INSTANCE(model="vbit", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $VPULSE;
  # @SELECT-INSTANCE(model="vprbs", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $VPULSE;
  # @SELECT-INSTANCE(model="ipulse", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $IPULSE;
  # @SELECT-INSTANCE(model="ibit", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $IPULSE;
  # @SELECT-INSTANCE(model="iprbs", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $IPULSE;
  # @SELECT-INSTANCE(model="vpwl", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $VPWL;
  # @SELECT-INSTANCE(model="vpwlf", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $VPWL;
  # @SELECT-INSTANCE(model="vexp", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $VPWL;
  # @SELECT-INSTANCE(model="ipwl", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $IPWL;
  # @SELECT-INSTANCE(model="ipwlf", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $IPWL;
  # @SELECT-INSTANCE(model="iexp", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $IPWL;
  # @SELECT-INSTANCE(model="diode", recursive=true) => @SET-SYMBOL(terminals=["a", "k"]) $DIODE;
  # @SELECT-INSTANCE(model="zener", recursive=true) => @SET-SYMBOL(terminals=["a", "k"]) $ZENER_DIODE;
  # @SELECT-INSTANCE(model="schottky", recursive=true) => @SET-SYMBOL(terminals=["a", "k"]) $SCHOTTKY;
  # @SELECT-INSTANCE(model="nmos", recursive=true) => @SET-SYMBOL(terminals=["d", "g", "s"]) $NMOS;
  # @SELECT-INSTANCE(model="ntft", recursive=true) => @SET-SYMBOL(terminals=["d", "g", "s"]) $NMOS;
  # @SELECT-INSTANCE(model="nmos4", recursive=true) => @SET-SYMBOL(terminals=["d", "g", "s", "b"]) $NMOS_4TERM;
  # @SELECT-INSTANCE(model="mos_level1", recursive=true) => @SET-SYMBOL(terminals=["d", "g", "s", "b"]) $NMOS_4TERM;
  # @SELECT-INSTANCE(model="pmos", recursive=true) => @SET-SYMBOL(terminals=["d", "g", "s"]) $PMOS;
  # @SELECT-INSTANCE(model="ptft", recursive=true) => @SET-SYMBOL(terminals=["d", "g", "s"]) $PMOS;
  # @SELECT-INSTANCE(model="pmos4", recursive=true) => @SET-SYMBOL(terminals=["d", "g", "s", "b"]) $PMOS_4TERM;
  # @SELECT-INSTANCE(model="npn", recursive=true) => @SET-SYMBOL(terminals=["c", "b", "e"]) $NPN;
  # @SELECT-INSTANCE(model="pnp", recursive=true) => @SET-SYMBOL(terminals=["c", "b", "e"]) $PNP;
  # @SELECT-INSTANCE(model="njfet", recursive=true) => @SET-SYMBOL(terminals=["d", "g", "s"]) $NJFET;
  # @SELECT-INSTANCE(model="pjfet", recursive=true) => @SET-SYMBOL(terminals=["d", "g", "s"]) $PJFET;
  # @SELECT-INSTANCE(model="vcvs", recursive=true) => @SET-SYMBOL(terminals=["p", "n", "cp", "cn"]) $VCVS_4TERM;
  # @SELECT-INSTANCE(model="vccs", recursive=true) => @SET-SYMBOL(terminals=["p", "n", "cp", "cn"]) $VCCS_4TERM;
  # @SELECT-INSTANCE(model="vcvsp", recursive=true) => @SET-SYMBOL $VCVSP;
  # @SELECT-INSTANCE(model="vccsp", recursive=true) => @SET-SYMBOL $VCCSP;
  # @SELECT-INSTANCE(model="cccs", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $CONTROLLED_CURRENT_SOURCE;
  # @SELECT-INSTANCE(model="ccvs", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $CONTROLLED_VOLTAGE_SOURCE;
  # @SELECT-INSTANCE(model="bsource", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $BEHAVIORAL_SOURCE;
  # @SELECT-INSTANCE(model="bvs", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $BEHAVIORAL_SOURCE;
  # @SELECT-INSTANCE(model="bcs", recursive=true) => @SET-SYMBOL(terminals=["p", "n"]) $BEHAVIORAL_SOURCE;
