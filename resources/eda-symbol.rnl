  # @SELECT-INSTANCE(model="bsource") => @SET-SYMBOL $BEHAVIORAL_SOURCE;
  # @SELECT-INSTANCE(model="bvs") => @SET-SYMBOL $BEHAVIORAL_SOURCE;
  # @SELECT-INSTANCE(model="bcs") => @SET-SYMBOL $BEHAVIORAL_SOURCE;
  # @SELECT-INSTANCE(model="relay") => @SET-SYMBOL $VOLTAGE_CONTROLLED_SWITCH;
